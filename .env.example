# Public site URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://codewavetech.in

# ntfy (https://ntfy.sh): push notification to the team's phones for every project brief.
# NTFY_TOPIC is required; `pnpm dev` refuses to start without it.
NTFY_SERVER_URL=https://ntfy.sh
NTFY_TOPIC=            # long random name, e.g. cwt-leads-8f3k2q9x7w
NTFY_TOKEN=            # access token if the topic is protected or self-hosted
NTFY_EMAIL=            # optional: also forward each brief to this email via ntfy

# Google reCAPTCHA v3 – optional. Verification runs only when RECAPTCHA_SECRET is set.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=

# Optional webhooks – each receives the brief as JSON when set
ZOHO_WEBHOOK_URL=
WHATSAPP_WEBHOOK_URL=
